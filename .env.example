COLLECTOR_MODE=mock
DATABASE_URL=sqlite:///data/collector.db
ALI_APP_KEY=
ALI_APP_SECRET=
ALI_SESSION=
ALI_TRACKING_ID=
# TOP gateway documented by Alibaba. Change only to the gateway assigned to your app.
ALI_GATEWAY=https://eco.taobao.com/router/rest
# top = HMAC-MD5, GMT+8 timestamp; sync = HMAC-SHA256, epoch milliseconds
ALI_PROTOCOL=top
ALI_ENABLE_DS=false
API_INTERVAL_SECONDS=1.5
API_MAX_RETRIES=4
